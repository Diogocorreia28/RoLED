struct Probabilidades {
  float hot[5];   //array para os 5 valores "quentes"
  float cold[5];  //array para os 5 valores "frio"
};
Probabilidades Prob_hot_cold(int* aparicoes, int totalNumeros) {
  Probabilidades resultados;

  for (int i = 0; i < 5; i++) {
    resultados.hot[i] = -1;  //inicializa vazio
    resultados.cold[i] = -1;
  }

  //criar cópias de aparições para ordenação
  int aparicoesHot[totalNumeros];
  int aparicoesCold[totalNumeros];
  for (int i = 0; i < totalNumeros; i++) {
    aparicoesHot[i] = aparicoes[i];
    aparicoesCold[i] = aparicoes[i];
  }

  //encontrar os 5 números mais frequentes
  for (int i = 0; i < 5; i++) {
    int maxFreq = -1;
    int hotIndex = -1;

    for (int j = 0; j < totalNumeros; j++) {
      if (aparicoesHot[j] > maxFreq) {
        maxFreq = aparicoesHot[j];
        hotIndex = j;
      }
    }

    resultados.hot[i] = hotIndex + 1;  // Número correspondente (índice + 1)
    aparicoesHot[hotIndex] = -1;       // Marcar como processado
  }

  // Encontrar os 5 números menos frequentes (cold)
  for (int i = 0; i < 5; i++) {
    int minFreq = 9999;
    int coldIndex = -1;

    for (int j = 0; j < totalNumeros; j++) {
      if (aparicoesCold[j] < minFreq && aparicoesCold[j] >= 0) {
        minFreq = aparicoesCold[j];
        coldIndex = j;
      }
    }

    resultados.cold[i] = coldIndex + 1;  // Número correspondente (índice + 1)
    aparicoesCold[coldIndex] = 9999;     // Marcar como processado
  }

  return resultados;
}

