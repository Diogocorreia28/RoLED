#include <FastLED.h>

#define LED_PIN     7
#define NUM_LEDS    24
#define BRIGHTNESS  64
#define LED_TYPE    WS2811
#define COLOR_ORDER GRB
CRGB leds[NUM_LEDS];

void setup() {
  delay(3000); // Atraso de segurança
  
  // Inicializa a faixa de LEDs
  FastLED.addLeds<LED_TYPE, LED_PIN, COLOR_ORDER>(leds, NUM_LEDS).setCorrection(TypicalLEDStrip);
  FastLED.setBrightness(BRIGHTNESS);

  // Configura as cores para cada LED
  for (int i = 0; i < NUM_LEDS; i++) {
    if (i == 0 || i == NUM_LEDS / 2) { // LEDs nas posições 0 e 12 (metade de 24)
      leds[i] = CRGB::Green;           // Verde
    } else if (i % 2 == 0) {           // LEDs nas posições pares
      leds[i] = CRGB::Red;             // Vermelho
    } else {
      leds[i] = CRGB::Blue;           // Apagado (preto)
    }
  }

  // Mostra os LEDs configurados
  FastLED.show(); 
}

void loop() {
  // O loop está vazio porque as configurações já são feitas no setup
}
