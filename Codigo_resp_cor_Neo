#include <FastLED.h>

#define LED_PIN     7
#define NUM_LEDS    24
#define BRIGHTNESS  64
#define LED_TYPE    WS2811
#define COLOR_ORDER GRB
CRGB leds[NUM_LEDS];


void setup() {
  delay(3000);
 
  FastLED.addLeds<LED_TYPE, LED_PIN, COLOR_ORDER>(leds, NUM_LEDS).setCorrection(TypicalLEDStrip);
  FastLED.setBrightness(BRIGHTNESS);

  for(int i = 0; i < NUM_LEDS; i++){
    if(i == 0 || i == NUM_LEDS / 2){ // posicoes 0 e 12
      leds[i] = CRGB::Green;
    }else if(i % 2 == 0){ // posicoes pares
      leds[i] = CRGB::Red;
    }else{
      leds[i] = CRGB::Black; // todas as outras sem ser a posicao 0, 12 e as pares 
    } 
  }
}

