void mostrarMaisFrequentes() {
  int contagem[24] = { 0 };  // contador para números de 0 a 23
  int numeros[25];

  // leitura dos 25 números mais recentes da eeprom
  for (int i = 0; i < 25; i++) {
    numeros[i] = EEPROM.read(i);
    contagem[numeros[i]]++;
  }

  // encrontra os 5 numeros mais recentes
  int maisFrequentes[5] = { -1, -1, -1, -1, -1 };
  int frequencias[5] = { 0, 0, 0, 0, 0 };  

  for (int i = 0; i < 24; i++) {
    if (contagem[i] > 0) {  // apenas os numeros que aparecem uma vez
      for (int j = 0; j < 5; j++) {
        if (contagem[i] > frequencias[j]) {
          //desloca para a direita
          for (int k = 4; k > j; k--) {
            maisFrequentes[k] = maisFrequentes[k - 1];
            frequencias[k] = frequencias[k - 1];
          }
          maisFrequentes[j] = i;
          frequencias[j] = contagem[i];
          break;
        }
      }
    }
  }

  // mostrar os resultados
  lcd.clear();
  lcd.setCursor(0, 0);
  lcd.print("Mais Frequentes:");
  lcd.setCursor(0, 1);
  for (int i = 0; i < 5; i++) {
    if (maisFrequentes[i] != -1) {
      lcd.print(maisFrequentes[i]);
      lcd.print(" ");
    }
  }

  
  Serial.println("Mais Frequentes:");
  for (int i = 0; i < 5; i++) {
    if (maisFrequentes[i] != -1) {
      Serial.print(maisFrequentes[i]);
      Serial.print(" ");
    }
  }
  Serial.println();
  delay(5000);
}

