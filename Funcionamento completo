void mostrarMaisFrequentes() {
    int contagem[24] = {0}; // Contador para números de 0 a 23
    int numeros[25];

    // Leitura dos 25 números da EEPROM
    for (int i = 0; i < 25; i++) {
        numeros[i] = EEPROM.read(i);
        contagem[numeros[i]]++;
    }

    // Encontrar os 5 números mais frequentes
    int maisFrequentes[5] = {-1, -1, -1, -1, -1};
    int frequencias[5] = {0, 0, 0, 0, 0}; // Inicializa com zero

    for (int i = 0; i < 24; i++) {
        if (contagem[i] > 0) { // Apenas números que apareceram pelo menos uma vez
            for (int j = 0; j < 5; j++) {
                if (contagem[i] > frequencias[j]) {
                    // Desloca os números para a direita
                    for (int k = 4; k > j; k--) {
                        maisFrequentes[k] = maisFrequentes[k - 1];
                        frequencias[k] = frequencias[k - 1];
                    }
                    maisFrequentes[j] = i;
                    frequencias[j] = contagem[i];
                    break;
                }
            }
        }
    }

    // Exibir os resultados no LCD
    lcd.clear();
    lcd.setCursor(0, 0);
    lcd.print("Mais Frequentes:");
    lcd.setCursor(0, 1);
    for (int i = 0; i < 5; i++) {
        if (maisFrequentes[i] != -1) {
            lcd.print(maisFrequentes[i]);
            lcd.print(" ");
        }
    }

    // Exibir no Serial
    Serial.println("Mais Frequentes:");
    for (int i = 0; i < 5; i++) {
        if (maisFrequentes[i] != -1) {
            Serial.print(maisFrequentes[i]);
            Serial.print(" ");
        }
    }
    Serial.println();
    delay(5000);
}

void mostrarMenosFrequentes() {
