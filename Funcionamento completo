  Probabilidades calcularProbabilidades(const int* aparicoes, int size) {  //tivemos de colocar aqui a função devido ao compilador não reconhecer o "Probabilidades"
    int frequencias[24] = { 0 };

    for (int i = 0; i < size; i++) {
      if (aparicoes[i] >= 0 && aparicoes[i] < 24) {  // Corrigido limite superior
        frequencias[aparicoes[i]]++;
      }
    }

    Probabilidades resultados;

    for (int k = 0; k < 5; k++) {
      int maxFreq = -1, maxNum = -1;
      for (int i = 0; i < 24; i++) {
        if (frequencias[i] > maxFreq) {
          maxFreq = frequencias[i];
          maxNum = i;
        }
      }
      resultados.hot[k] = maxNum;
      frequencias[maxNum] = -1;  // Marcar como usado

      int minFreq = size + 1, minNum = -1;
      for (int i = 0; i < 24; i++) {
        if (frequencias[i] >= 0 && frequencias[i] < minFreq) {
          minFreq = frequencias[i];
          minNum = i;
        }
      }
      resultados.cold[k] = minNum;
      frequencias[minNum] = -1;  // Marcar como usado
    }

    return resultados;
  }
